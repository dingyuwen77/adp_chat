{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADP Chat business interaction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "interaction"],
  "properties": {
    "schema": {"const": "adp-chat.interaction.v1"},
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status", "message", "missing_fields", "confirmation_required"],
      "properties": {
        "type": {"enum": ["ANSWER", "CLARIFICATION", "CONFIRMATION"]},
        "status": {"enum": ["COMPLETED", "WAITING_USER"]},
        "message": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "missing_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
        "confirmation_required": {"type": "boolean"}
      },
      "oneOf": [
        {"properties": {"type": {"const": "ANSWER"}, "status": {"const": "COMPLETED"}, "missing_fields": {"maxItems": 0}, "confirmation_required": {"const": false}}},
        {"properties": {"type": {"const": "CLARIFICATION"}, "status": {"const": "WAITING_USER"}, "confirmation_required": {"const": false}}},
        {"properties": {"type": {"const": "CONFIRMATION"}, "status": {"const": "WAITING_USER"}, "missing_fields": {"maxItems": 0}, "confirmation_required": {"const": true}}}
      ]
    }
  }
}
